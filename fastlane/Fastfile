# Headless iOS pipeline — Fastlane lanes.
#
# Lane summary:
#   build_ci  Unsigned compile on a CI Mac. Needs NO Apple account. This is the
#             lane the "Build (headless proof)" workflow proves end-to-end.
#   beta      Signed build -> TestFlight. Needs the secrets listed in README.md
#             (App Store Connect API key + fastlane match signing repo).
#   release   Signed build -> App Store Connect (upload only; Kevin taps
#             "Submit for Review" — nothing auto-submits to Apple review).
#
# Bundle ID: com.kevinflanagan.pipelinedemo

default_platform(:ios)

APP_IDENTIFIER = "com.kevinflanagan.pipelinedemo"

platform :ios do
  desc "CI proof: compile the app with signing disabled (no Apple account needed)"
  lane :build_ci do
    build_app(
      project: "PipelineDemo.xcodeproj",
      scheme: "PipelineDemo",
      configuration: "Release",
      clean: true,
      skip_archive: true,
      skip_codesigning: true,
      destination: "generic/platform=iOS",
      derived_data_path: "build/DerivedData",
      output_directory: "build"
    )
  end

  desc "Build + upload to TestFlight (requires signing secrets — see README)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      readonly: true,
      app_identifier: APP_IDENTIFIER,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    build_app(
      project: "PipelineDemo.xcodeproj",
      scheme: "PipelineDemo",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "PipelineDemo.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build + upload to App Store Connect (upload only — no auto-submit for review)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      readonly: true,
      app_identifier: APP_IDENTIFIER,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    build_app(
      project: "PipelineDemo.xcodeproj",
      scheme: "PipelineDemo",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "PipelineDemo.ipa"
    )

    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true
    )
  end
end
